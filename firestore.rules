rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Par défaut, interdire tout accès en lecture et écriture
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Règles pour les produits (products)
    // Permet la lecture à tous les utilisateurs authentifiés
    // Permet l'écriture uniquement aux administrateurs ou fournisseurs spécifiques
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.admin == true || 
        (request.auth.token.supplier == true && resource.data.supplierId == request.auth.uid)
      );
    }
    
    // Règles pour les catégories (categories)
    // Lecture autorisée aux utilisateurs authentifiés
    // Écriture réservée aux administrateurs
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Règles pour les notifications (notifications)
    // Lecture autorisée aux utilisateurs authentifiés s'ils sont destinataires ou si globale
    // Écriture réservée aux administrateurs ou système authentifié
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.target == 'all' ||
        request.auth.token.admin == true
      );
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Règles pour les profils utilisateurs (users)
    // Un utilisateur ne peut lire/écrire que son propre document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Règles pour les commandes (orders)
    // Un utilisateur ou fournisseur ne peut lire/écrire que ses propres commandes
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        resource.data.supplierId == request.auth.uid ||
        request.auth.token.admin == true
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        request.auth.token.admin == true
      );
    }
  }
}
